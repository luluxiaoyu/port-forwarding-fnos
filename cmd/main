#!/bin/sh
set -eu

: "${TRIM_APPDEST:?}" "${TRIM_PKGVAR:?}" "${TRIM_PKGETC:?}"
binary="$TRIM_APPDEST/bin/port-forwarding"
pid_file="$TRIM_PKGVAR/server.pid"
ready_file="$TRIM_PKGVAR/server.ready"
log_file="$TRIM_PKGVAR/server.log"
mkdir -p "$TRIM_PKGVAR"

# Serialize App Center operations. The daemon closes this lock descriptor.
exec 9>"$TRIM_PKGVAR/control.lock"
flock -x 9

is_running() {
    pid=
    [ -f "$pid_file" ] && IFS= read -r pid < "$pid_file" || return 1
    case "$pid" in ''|*[!0-9]*|0|1) return 1 ;; esac
    [ "/proc/$pid/exe" -ef "$binary" ] && kill -0 "$pid" 2>/dev/null
}

is_ready() {
    is_running && [ -S "$TRIM_APPDEST/app.sock" ] &&
        [ -f "$ready_file" ] && [ "$(cat "$ready_file" 2>/dev/null)" = "$pid" ]
}

report() {
    printf '%s\n' "$1" >&2
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$1" >> "$TRIM_TEMP_LOGFILE"
    fi
}

case "${1:-}" in
    start)
        if is_ready; then exit 0; fi
        if is_running; then
            report "端口转发服务正在启动"
            exit 1
        fi
        rm -f "$ready_file" "$pid_file"
        mkdir -p "$TRIM_PKGETC"
        nohup "$binary" 9>&- </dev/null >>"$log_file" 2>&1 &
        started_pid=$!
        printf '%s\n' "$started_pid" > "$pid_file"
        count=0
        while [ "$count" -lt 50 ]; do
            if is_ready; then exit 0; fi
            if ! kill -0 "$started_pid" 2>/dev/null; then break; fi
            count=$((count + 1))
            sleep 0.2
        done
        if is_running; then kill -TERM "$pid" 2>/dev/null || :; fi
        report "端口转发服务启动失败，请查看 $log_file"
        exit 1
        ;;
    stop)
        if is_running; then
            kill -TERM "$pid" 2>/dev/null || :
            count=0
            while is_running && [ "$count" -lt 30 ]; do
                count=$((count + 1))
                sleep 0.2
            done
            if is_running; then
                report "端口转发服务停止超时，请查看 $log_file"
                exit 1
            fi
        fi
        rm -f "$pid_file" "$ready_file"
        ;;
    status)
        if is_ready; then exit 0; fi
        exit 3
        ;;
    *) exit 1 ;;
esac
